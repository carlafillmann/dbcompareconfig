rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // O acesso direto é necessário para o catálogo compartilhado de conexões.
    // Senhas de bases externas nunca são armazenadas nesta coleção.
      match /connections/{connectionId} {
        allow read, write: if true;
      }
      match /users/{userId} {
        allow read, write: if true;
      }
      // Versão publicada do Connector, consultada pela aplicação para avisar
      // quando a API local instalada estiver desatualizada.
      match /settings/{settingId} {
        allow read, write: if true;
      }
      match /parameterGroups/{groupId} {
        allow read, write: if true;
      }
  }
}
