# Porta da API local
PORT=3333
HOST=127.0.0.1
# Endereço da API que testa e compara as bases corporativas. Não é usada para o Firestore.
EXPO_PUBLIC_DATABASE_API_URL=http://127.0.0.1:3333
# Domínios permitidos a chamar a API local, separados por vírgula.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,https://dbcompareconf.web.app,https://dbcompareconf.firebaseapp.com

# Configuração pública do projeto Firestore. A chave de API do Firebase não é segredo.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=dbcompareconfig-bec7c
EXPO_PUBLIC_FIREBASE_API_KEY=
