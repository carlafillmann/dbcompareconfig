# Porta da API local
PORT=3333
HOST=127.0.0.1
# Endereço da API que a interface web chamará. Mantenha local para uso na rede corporativa.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3333
# Domínios permitidos a chamar a API local, separados por vírgula.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,https://dbcompareconf.web.app,https://dbcompareconf.firebaseapp.com

# Chave de 64 caracteres hexadecimais para criptografar senhas no Firestore.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTION_ENCRYPTION_KEY=

# Opção 1: caminho absoluto para o JSON da conta de serviço Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Opção 2: use estas variáveis quando a conta de serviço não estiver em arquivo
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
