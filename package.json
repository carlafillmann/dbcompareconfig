{
  "name": "db-compare-config",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "api": "tsx watch server/src/index.ts",
    "start": "concurrently -n web,api -c cyan,magenta \"npm run web\" \"npm run api\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@react-native-picker/picker": "^2.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "expo": "^54.0.0",
    "expo-status-bar": "^3.0.8",
    "firebase-admin": "^13.4.0",
    "mssql": "^11.0.1",
    "oracledb": "^6.8.0",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mssql": "^9.1.7",
    "@types/node": "^24.3.0",
    "@types/oracledb": "^6.6.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
